<%- include partials/header.ejs %>
<%- include partials/navbar.ejs %>
<div class="container mt-5 mb-5 pb-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <img src="/stylesheets/images/LINKHOP Logo.jpg" alt="LinkHop logo" class="img-fluid rounded-4">
          <p class="text-center text-muted mb-4">Submit a link for analysis.</p>

          <form action="/reports/add" method="POST">
            <!--Field to insert a link to be checked-->
            <div class="mb-3">
              <label for="url" class="form-label">Suspicious URL:</label>
              <input type="url" class="form-control" id="url" name="url" placeholder="https://example.com" required >
            </div>
            <!--Selection dropdown for link luring type-->
            <div class="mb-3">
              <label for="lurecategory" class="form-label">Lure Category:</label>
              <select class="form-select" id="lurecategory" name="lurecategory" required>
                <option value="" selected disabled>Select a category</option>
                <option value="Package Delivery">Package Delivery</option>
                <option value="Banking">Banking</option>
                <option value="Account Verification">Account Verification</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <!--Optional description field area-->
            <div class="mb-3">
              <label for="description" class="form-label">Description (Optional):</label>
              <textarea class="form-control" id="description" name="description" rows="3" placeholder="Describe the message" ></textarea>
            </div>
            <!--Submit button-->
            <div class="d-grid">
              <button type="submit" class="btn btn-primary">Analyze URL</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include partials/footer.ejs %>
